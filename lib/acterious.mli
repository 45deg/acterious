(** 固定数の Domain からなるプール上で複数のアクターを実行する、学習用のアクターフレームワーク。 *)

module Pool : sig
  type t

  val create :
    sw:Eio.Switch.t ->
    domain_mgr:_ Eio.Domain_manager.t ->
    domains:int ->
    unit ->
    t
  (** [domains] 個のワーカー Domain からなるプールを作成する（[domains] には 1 以上を指定すること）。
      各ワーカーは独自の Eio イベントループを持ち、プール作成時にのみ生成されるため、あとからアクターを
      起動しても Domain 数は増えない。呼び出しは [Eio_main.run] と [Eio.Switch.run] の内側で行い、
      [Fun.protect] の [finally] で必ず [shutdown] を呼んでから [sw] を抜けること。ワーカーは受理済みの
      処理を最後まで完遂できるようキャンセルを遮蔽しているため、親の [sw] が終了するだけでは停止しない。 *)

  val shutdown : t -> unit
  (** プール内の全アクターへの新規送信と新たなアクターの起動を締め切り、全ワーカーの終了を待つ。
      各メールボックスに受理済みのメッセージがすべて処理されるまで待機するが、待機中は呼び出し元の Fiber が
      中断されるため、同じ Domain 上の他の Fiber は実行を続けられる。終了処理はキャンセルから保護されており、
      実行中や待機中のハンドラーがすべて完了するまで戻らない。複数回呼び出しても安全である。なお、ハンドラー内で
      発生した例外はここでは送出されないため、個別アクターの成否は [Actor.join] で確認すること。また、
      デッドロックを防ぐため、同じプールのハンドラー内からは呼び出さないこと。 *)
end

module Actor : sig
  type 'message t
  (** ['message] 型のメッセージを受け取るアクターの宛先。 *)

  val spawn :
    Pool.t -> initial:'state -> ('state -> 'message -> 'state) -> 'message t
  (** [spawn pool ~initial handle] は、初期状態 [initial] とハンドラー [handle] を持つアクターを
      [pool] 上に起動する（すでに閉じたプールに対して呼び出すと [Invalid_argument] を送出する）。
      メッセージを 1 件処理するたびに [handle state message] が呼ばれ、その戻り値が次の状態になる。
      実行を担当する Domain はメッセージごとに変わりうるが、同じアクター宛てのメッセージは常に 1 件ずつ順番に
      処理され、ハンドラーが Eio の I/O などで待機している間も後続のメッセージが先に開始されることはない。
      なお、状態やメッセージの値自体はコピーされないため、可変な値を外部と共有する場合は呼び出し側で適切に同期すること。 *)

  val send : 'message t -> 'message -> bool
  (** アクターのメールボックスにメッセージを追加し、受理されれば [true]、アクターまたはプールがすでに
      閉じていれば [false] を返す。メールボックスに容量制限はなく、短い Mutex のロック取得を除いて空き待ちや
      処理完了待ちでブロックすることはない。そのため、[true] はメールボックスへの追加成功を表すだけであり、
      ハンドラーの処理完了は意味しない（ハンドラーが未捕捉例外で失敗した場合は、後続の未処理メッセージは破棄される）。
      複数の Domain から同時に呼び出すことができ、同一の送信元から送った順序は常に保たれる（異なる送信元の間では
      ロックを取得した順になる）。 *)

  val stop : 'message t -> unit
  (** このアクターへの新規メッセージの送信を締め切る。締め切り前に受理されたメッセージは最後まで処理されるが、
      この関数自体は処理の完了を待たずに即座に戻る。実行中のハンドラーを中断することはなく、複数回呼び出しても安全である。 *)

  val join : 'message t -> unit
  (** アクターが閉じられ、受理済みの処理がすべて完了するまで待機する。[join] 自体は終了を要求しないため、
      通常は先に [stop] を呼んでから Eio の Fiber 上で呼び出すこと。待機中は呼び出し元の Fiber が中断されるだけであり、
      もし待機中に呼び出し元がキャンセルされてもアクター自体は停止しない。ハンドラーで未捕捉例外が発生していた場合は、
      保存された例外を元のバックトレースとともに再送出する。なお、自己待ちや循環待ちによるデッドロックを避けるため、
      ハンドラー内からは呼び出さないこと。 *)
end
